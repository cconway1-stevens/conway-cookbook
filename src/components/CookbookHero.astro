---
import RecipeRolodex from './RecipeRolodex.astro';
import { book } from '../lib/cookbook';
import { base, type Recipe } from '../lib/recipes';
import '../hero.css';

interface Props {
  recipes: Recipe[];
}

const { recipes } = Astro.props;
---
<section class="cookbook-hero" aria-labelledby="cover-title">
  <div class="wrap">
    <div class="book-spread">
      <div class="book-title-leaf">
        <h1 id="cover-title"><span>{book.cover.small}</span> {book.cover.large}</h1>
        <p>{book.tagline}</p>
        <div class="cover-actions"><a class="button" href={base + 'recipes/'}>Find a recipe</a><a class="button quiet" href={base + 'menu/'}>Build a menu</a></div>
      </div>
      <RecipeRolodex recipes={recipes} />
    </div>
  </div>
</section>
<script>import '../scripts/randomizer';</script>
