---
// Text with its ingredient words wrapped, so a hover can find them.
const { parts = [], entries } = Astro.props;
---
{parts.map((part: string | { s: string; e?: string[]; o?: string[]; g?: string; gm?: string }) => {
  if (typeof part === 'string') return part;
  const entry = part.e?.length === 1 && !part.o?.length && entries?.[part.e[0]];
  return <>
    <span class:list={['ing', { 'ing-group': part.gm }]} data-e={part.e?.join(' ')} data-o={part.o?.join(' ')} data-g={part.g} data-gm={part.gm}>{part.s}</span>{entry && entry.steps.length === 1 && <small class="inline-amount"> ({entry.line})</small>}
  </>;
})}
