---
// Text with its ingredient words wrapped, so a hover can find them.
const { parts = [], emphasizeTiming = false } = Astro.props;
const timing = /(\b\d+(?:[–-]\d+)?\s*(?:°[FC]|minutes?\b|hours?\b|seconds?\b))/g;
---
{parts.map((p: string | { s: string; e?: string[]; o?: string[]; g?: string; gm?: string }) => (
  typeof p === 'string'
    ? emphasizeTiming ? p.split(timing).map((part, index) => index % 2 ? <strong>{part}</strong> : part) : p
    : <span class:list={['ing', { 'ing-group': p.gm }]} data-e={p.e?.join(' ')} data-o={p.o?.join(' ')} data-g={p.g} data-gm={p.gm}>{p.s}</span>
))}
