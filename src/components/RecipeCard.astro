---
import Spot from './Spot.astro';
import { base, recipeUrl, searchText, isSample, type Recipe } from '../lib/recipes';
import { slug } from '../lib/cookbook';

interface Props {
  recipe: Recipe;
  level?: 'h2' | 'h3' | 'h4';
}

const { recipe, level = 'h3' } = Astro.props;
const { id, data } = recipe;
const Heading = level;
---
<li class="card" data-course={slug(data.category)} data-id={id} data-search={searchText(recipe)}
  data-meal={data.meal.join('|')} data-cuisine={data.cuisine.join('|')} data-tags={data.tags.join('|')} data-minutes={data.minutes}>
  <p class="card-tab">{data.category}</p>
  <div class="card-face">
    {data.image
      ? <img class="card-photo" src={base + `card-images/${id}/360.webp`} srcset={`${base}card-images/${id}/360.webp 360w, ${base}card-images/${id}/720.webp 720w`} sizes="(max-width: 600px) 90vw, 360px" alt="" width="600" height="400" loading="lazy" />
      : <div class="card-photo card-art"><Spot category={data.category} /></div>}
    <div class="card-top">
      <Heading class="card-title"><a href={recipeUrl(id)}>{data.title}</a></Heading>
    </div>
    <p class="card-desc">{data.description}</p>
    <p class="card-meta">{data.time} · serves {data.servings}{isSample(recipe) && ' · sample'}</p>
    <div class="card-foot">
      <ul class="tapes" aria-label="Cuisine">{data.cuisine.map((c: string) => <li class="tape">{c}</li>)}</ul>
      <div class="card-go">
        <button type="button" class="to-cook-button" data-to-cook={id} data-title={data.title} hidden>To cook</button>
        <button type="button" class="add" data-add={id} data-title={data.title} hidden>Add to menu</button>
      </div>
    </div>
  </div>
</li>
