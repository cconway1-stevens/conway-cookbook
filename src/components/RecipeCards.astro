---
import { base, recipeUrl, type Recipe } from '../lib/recipes';
const { recipes, nested }: { recipes: Recipe[]; nested?: boolean } = Astro.props;
const Heading = nested ? 'h3' : 'h2';
---
<ul class="cards">
  {recipes.map(({ id, data, body }) => (
    <li data-recipe data-search={[data.title, data.description, data.category, data.author, body].join(' ')}>
      <a class="recipe-card" href={recipeUrl(id)}>
        {data.image
          ? <img src={base + data.image} alt={data.imageAlt ?? ''} width="600" height="400" loading="lazy" />
          : <div class="card-paper" aria-hidden="true"><span>{data.category}</span></div>}
        <div class="card-copy">
          <span class="category">{data.category}</span>
          <Heading>{data.title}</Heading>
          <p>{data.description}</p>
          <span class="recipe-time">{data.time}</span>
        </div>
      </a>
    </li>
  ))}
</ul>
