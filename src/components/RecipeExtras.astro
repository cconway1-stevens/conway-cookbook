---
// Photos, video, sound, and notes. The published ones come from the repo; the visitor's
// own stay in their browser (scripts/gallery.ts).
import { mediaFor, publishLinks } from '../lib/media';
const { recipe } = Astro.props;
const media = mediaFor(recipe);
const links = publishLinks(recipe);
const notes: { text: string; by?: string; date?: Date }[] = recipe.data.familyNotes ?? [];
const when = (d?: Date) => d && d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<section class="extras" id="photos" aria-labelledby="photos-title" data-recipe={recipe.id}>
  <div class="block-head">
    <h2 id="photos-title">Photos and video</h2>
    <label class="button quiet add-media" hidden>Add photos or video<input type="file" id="media-file" class="vh" multiple accept="image/*,video/*,audio/*" /></label>
  </div>
  <ul class="gallery" id="gallery">
    {media.map((m) => (
      <li class:list={['shot', m.kind]}>
        {m.kind === 'photo' && <a class="shot-open" href={m.src} data-kind="photo" data-caption={m.caption} data-by={m.by}><img src={m.thumb ?? m.src} alt={m.alt} width="560" height="560" loading="lazy" /></a>}
        {m.kind === 'video' && <video controls preload="metadata" playsinline src={m.src} aria-label={m.caption || 'Video'} />}
        {m.kind === 'audio' && <audio controls preload="metadata" src={m.src} aria-label={m.caption || 'Recording'} />}
        {m.kind === 'embed' && <button type="button" class="shot-play" data-src={m.src} data-title={m.caption}><span aria-hidden="true">▶</span>Play video</button>}
        {(m.kind === 'link' || m.kind === 'file') && <a class="shot-link" href={m.src} rel="noopener">{m.kind === 'file' ? 'Open the PDF' : 'Open the link'}</a>}
        {(m.caption || m.by) && <p class="shot-words">{m.caption}{m.by && <small> {m.caption && '· '}{m.by}</small>}</p>}
      </li>))}
  </ul>
  <p class="gallery-empty" id="gallery-empty" hidden={media.length > 0}>No photos yet. Made it? Add the first one.</p>
  <p class="gallery-say" id="gallery-say" role="status"></p>
  {links && (
    <details class="publish" id="publish">
      <summary>Publish photos for everyone</summary>
      <ol>
        <li>Add your photos above. Each one is resized, and hidden data such as its location is removed.</li>
        <li><button type="button" class="linkish" id="media-save" hidden>Save the cleaned photos to this device</button><span id="media-save-none">Once you have added one, a save button shows up here.</span></li>
        <li><a href={links.upload} rel="noopener">Open this recipe’s folder on GitHub</a>, drop the saved files in, and commit. They appear here after the next deploy.</li>
      </ol>
      <p>You need access to the cookbook’s GitHub. Files can be up to 25 MB each.</p>
    </details>)}
</section>
<section class="extras" id="notes" aria-labelledby="notes-title">
  <h2 id="notes-title">Notes</h2>
  {notes.length > 0 && <ul class="family-notes">{notes.map((n) => <li><p>{n.text}</p>{(n.by || n.date) && <small>{[n.by, when(n.date)].filter(Boolean).join(', ')}</small>}</li>)}</ul>}
  <div class="my-notes" hidden>
    <label for="my-notes">My notes</label>
    <textarea id="my-notes" rows="5" maxlength="6000" placeholder="Less sugar next time. Doubled it for Thanksgiving."></textarea>
    <div class="my-notes-foot"><span id="notes-say" role="status">Kept in this browser only.</span><button type="button" class="linkish" id="notes-copy">Copy</button>{links && <a href={links.edit} rel="noopener">Publish a note on GitHub</a>}</div>
  </div>
</section>
<dialog id="lightbox" aria-label="Photo">
  <button type="button" class="button quiet" id="lb-close">Close</button>
  <button type="button" class="lb-go" id="lb-prev" aria-label="Previous photo">‹</button>
  <figure><img id="lb-img" alt="" /><figcaption id="lb-words"></figcaption></figure>
  <button type="button" class="lb-go" id="lb-next" aria-label="Next photo">›</button>
</dialog>
<script>import '../scripts/gallery';</script>
