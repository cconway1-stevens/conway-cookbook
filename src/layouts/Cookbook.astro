---
import '@fontsource/oleo-script/latin-400.css';
import '@fontsource/oleo-script/latin-700.css';
import '@fontsource/zilla-slab/latin-400.css';
import '@fontsource/zilla-slab/latin-400-italic.css';
import '@fontsource/zilla-slab/latin-600.css';
import '@fontsource/zilla-slab/latin-700.css';
import '@fontsource/courier-prime/latin-400.css';
import '@fontsource/courier-prime/latin-700.css';
import '@fontsource/libre-caslon-text/latin-400.css';
import '@fontsource/libre-caslon-text/latin-400-italic.css';
import '@fontsource/libre-caslon-text/latin-700.css';
import '@fontsource/libre-caslon-display/latin-400.css';
import '@fontsource/homemade-apple/latin-400.css';
import '../style.css';
import '../themes';
import '../motion.css';
import { allRecipes, base, json } from '../lib/recipes';
import SiteHeader from '../components/SiteHeader.astro';
import { book } from '../lib/cookbook';
const thumbs = (await allRecipes()).filter((r) => r.data.image).map((r) => `${base}thumbs/${r.id}.jpg`);
const { title, description = book.description, current = '' } = Astro.props;
const bars = Object.fromEntries(book.themes.map((t) => [t.id, t.bar]));
---
<!doctype html>
<html lang="en" data-theme={book.themes[0].id}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content={book.themes[0].bar} />
  {/* Runs before anything paints, so the page never flashes the wrong theme. */}
  <script is:inline define:vars={{ bars }}>
    try {
      const id = localStorage.getItem('conway-theme');
      if (id && Object.hasOwn(bars, id)) { document.documentElement.dataset.theme = id; document.querySelector('meta[name=theme-color]').content = bars[id]; }
    } catch { /* storage blocked: keep the first theme */ }
  </script>
  <meta name="description" content={description} />
  {thumbs[0] && <link rel="icon" type="image/jpeg" href={thumbs[0]} />}
  <title>{title ? `${title} | ${book.title}` : book.title}</title>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <SiteHeader current={current} thumbs={thumbs} />
  <main id="main"><slot /></main>
  <footer class="footer">
    <div class="wrap footer-inner">
      <div class="footer-brand">
        <a href={base} class="wordmark">{book.title}</a>
        <span>{book.footer}</span>
      </div>
      <div class="footer-meta">
        <span>Made by Cameron Conway</span>
        {book.repo && (
          <a class="footer-source" href={`https://github.com/${book.repo}`}>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m8 6-6 6 6 6m8-12 6 6-6 6" /></svg>
            GitHub
          </a>
        )}
      </div>
    </div>
  </footer>
  <script is:inline type="application/json" id="menu-book" set:html={json(book.menu)} />
  <script is:inline type="application/json" id="theme-bars" set:html={json(bars)} />
  <button type="button" class="help-button acc-container" data-reading-help aria-label="Reading and accessibility help" title="Make this easier to read" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="4.2" r="2.2" /><path d="M4 8.2c3 1 5 1.3 8 1.3s5-.3 8-1.3M12 9.5v5M12 14.5l-3.2 7M12 14.5l3.2 7M9 9.4v5.1h6V9.4" /></svg></button>
  <div id="toast" role="status" aria-live="polite"></div>
</body>
</html>
<script>import '../scripts/site';
import '../scripts/icon';
import '../scripts/reading-help';</script>
