---
import Cookbook from '../layouts/Cookbook.astro';
import { lessons, pantryHackLessonsUrl } from '../lib/academy';
import { modules } from '../lib/coursework';
---
<Cookbook title="Cooking Academy" current="academy">
  <div class="wrap academy">
    <header>
      <h1>Cooking Academy</h1>
      <p>Sign in to Pantry Hack to access the core cooking lessons.</p>
      <a class="button" href={pantryHackLessonsUrl}>Open Pantry Hack</a>
    </header>
    {modules.map(module => (
      <section id={module.id} class="panel">
        <h2>{module.title}</h2>
        <ul>
          {module.ids.map(id => {
            const lesson = lessons.find(item => item.id === id)!;
            return <li id={id}><a href={pantryHackLessonsUrl}>{lesson.title}</a></li>;
          })}
        </ul>
      </section>
    ))}
    <section class="panel">
      <h2>Live classes</h2>
      <p>The Institute of Culinary Education lists free instructor-led classes and registration details on its site. <a href="https://www.ice.edu/newyork/free-online-cooking-classes">Explore ICE classes</a></p>
    </section>
  </div>
</Cookbook>

<style>
  .academy { max-width: 64rem; padding-block: 2rem 4rem; }
  .academy header { padding: clamp(1.25rem, 4vw, 2.5rem); background: var(--card); border: 1px solid var(--line); border-radius: .6rem; }
  .academy header .button { margin-top: 1rem; }
  .academy li + li { margin-top: .45rem; }
</style>
