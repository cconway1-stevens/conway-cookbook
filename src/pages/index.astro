---
import { getCollection } from 'astro:content';
import Cookbook from '../layouts/Cookbook.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const recipes = (await getCollection('recipes')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf() || a.data.title.localeCompare(b.data.title));
const featured = recipes.find((recipe) => recipe.data.image) ?? recipes[0];
---
<Cookbook>
  <div class="wrap">
    <section class="hero" aria-labelledby="cover-title">
      <div class="cover-copy">
        <h1 id="cover-title">The Conway<br /><em>Cookbook</em></h1>
        <p>A place for the recipes we come back to and the stories that go with them.</p>
        <a class="button" href="#recipes">Browse the recipes</a>
      </div>
      {featured && (
        <figure class="polaroid">
          <a href={base + 'recipes/' + featured.id + '/'}>
            {featured.data.image && <img src={base + featured.data.image} alt={featured.data.imageAlt ?? featured.data.title} width="960" height="640" fetchpriority="high" />}
          </a>
          <figcaption><a href={base + 'recipes/' + featured.id + '/'}>{featured.data.title}</a></figcaption>
        </figure>
      )}
    </section>
    <section class="index" id="recipes" aria-labelledby="index-title">
      <h2 id="index-title">Recipe index</h2>
      {recipes.length ? (
        <ul class="recipe-index">
          {recipes.map(({ id, data }) => (
            <li><a href={base + 'recipes/' + id + '/'}>
              <span class="category">{data.category}</span>
              <span class="recipe-name">{data.title}</span>
              <span class="recipe-time">{data.time}</span>
            </a></li>
          ))}
        </ul>
      ) : <p>The cookbook is ready for its first recipe.</p>}
    </section>
  </div>
</Cookbook>
