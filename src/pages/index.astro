---
import Cookbook from '../layouts/Cookbook.astro';
import RecipeCards from '../components/RecipeCards.astro';
import { base, categoryUrl, getCategories, getRecipes } from '../lib/recipes';
const recipes = await getRecipes();
const chapters = getCategories(recipes).map((name) => ({
  name,
  count: recipes.filter(({ data }) => data.category === name).length,
}));
const featured = recipes.find(({ id }) => id === 'apple-crumble-pie');
const picks = [...new Set([featured, ...recipes])].filter((recipe) => recipe !== undefined).slice(0, 4);
---
<Cookbook>
  <section class="welcome">
    <div class="wrap welcome-inner">
      <div class="cover-copy">
        <p class="category">From the Conway kitchen</p>
        <h1>The Conway<br /><em>Cookbook</em></h1>
        <p>A place for the recipes we come back to and the stories that go with them.</p>
        <a class="button" href={base + 'recipes/'}>Open the recipe box</a>
      </div>
      <figure class="cover-art">
        <img src={base + 'images/cookbook-cover.jpg?v=crumb-top'} width="960" height="1200" alt="Illustrated cinnamon-oat crumble pie, apple blossoms, and gingham on cream paper" fetchpriority="high" />
      </figure>
    </div>
  </section>
  <div class="wrap home-sections">
    <section aria-labelledby="chapters">
      <h2 id="chapters">Browse by chapter</h2>
      <ul class="chapter-grid">
        {chapters.map(({ name, count }) => <li><a href={categoryUrl(name)}><span>{name}</span><small>{count} {count === 1 ? 'recipe' : 'recipes'}</small></a></li>)}
      </ul>
    </section>
    <section aria-labelledby="recipe-picks">
      <div class="section-heading"><h2 id="recipe-picks">From the recipe box</h2><a href={base + 'recipes/'}>View all recipes</a></div>
      <RecipeCards recipes={picks} nested />
    </section>
  </div>
</Cookbook>
