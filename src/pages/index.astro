---
import Cookbook from '../layouts/Cookbook.astro';
import RecipeCard from '../components/RecipeCard.astro';
import CookbookHero from '../components/CookbookHero.astro';
import { allRecipes, base, tally } from '../lib/recipes';
import { book, courseOf } from '../lib/cookbook';
const recipes = await allRecipes();
const meals = book.meals.map((m) => [m, recipes.filter((r) => r.data.meal.includes(m)).length] as const).filter(([, n]) => n);
const cuisines = tally(recipes.flatMap((r) => r.data.cuisine));
const q = (key: string, value: string) => `${base}recipes/?${key}=${encodeURIComponent(value)}`;
---
<Cookbook>
  <CookbookHero recipes={recipes} />

  <div class="wrap">
    <section class="block" aria-labelledby="meals-title">
      <h2 id="meals-title">Find it by the meal</h2>
      <ul class="dividers">
        {meals.map(([meal, n]) => <li><a href={q('meal', meal)}><span>{meal}</span><small>{n} {n === 1 ? 'card' : 'cards'}</small></a></li>)}
      </ul>
      <div class="cuisine-row">
        <h3>Or by the kitchen</h3>
        <ul class="tapes">{cuisines.map(([c]) => <li><a class="tape" href={q('cuisine', c)}>{c}</a></li>)}</ul>
      </div>
    </section>

    <section class="block" aria-labelledby="box-title">
      <div class="block-head">
        <h2 id="box-title">From the recipe box</h2>
        <div class="block-actions">
          <button type="button" class="button quiet" data-pull hidden>Pull a card for me</button>
          <a class="button" href={base + 'recipes/'}>Open the whole box</a>
        </div>
      </div>
      <ul class="cards">{recipes.slice(0, 6).map((recipe) => <RecipeCard recipe={recipe} />)}</ul>
    </section>

    <section class="invite" aria-labelledby="invite-title">
      <div>
        <h2 id="invite-title">Put a menu together</h2>
        <p>Pick dishes from the box, choose a paper, and print a menu for the table. Your shopping list writes itself.</p>
        <a class="button" href={base + 'menu/'}>Build a menu</a>
      </div>
      <div class="mini-menu" aria-hidden="true">
        <b>{book.menu.title}</b>
        {book.menu.sections.map((sec) => recipes.find((r) => courseOf(r.data.category).menu === sec.id)).filter((r) => r !== undefined).slice(0, 4).map((r) => <span>{r.data.title}</span>)}
      </div>
    </section>
  </div>
</Cookbook>
