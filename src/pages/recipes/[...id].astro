---
import { render } from 'astro:content';
import Cookbook from '../../layouts/Cookbook.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import Spot from '../../components/Spot.astro';
import { academyLinksFor } from '../../lib/academy';
import { nutritionFor } from '../../lib/nutrition';
import RecipeExtras from '../../components/RecipeExtras.astro';
import Parts from '../../components/Parts.astro';
import CookMode from '../../components/CookMode.astro';
import { allRecipes, base, directions, ingredients, isSample, json, linkOf, recipeUrl } from '../../lib/recipes';

export async function getStaticPaths() {
  const recipes = await allRecipes();
  return recipes.map((recipe) => ({
    params: { id: recipe.id },
    props: {
      recipe,
      // Goes well with: a different course, sharing a cuisine or a meal.
      pairs: recipes
        .filter((r) => r.id !== recipe.id && r.data.category !== recipe.data.category)
        .map((r) => ({ r, score: 2 * Number(r.data.cuisine.some((c) => recipe.data.cuisine.includes(c))) + Number(r.data.meal.some((m) => recipe.data.meal.includes(m))) }))
        .filter(({ score }) => score).sort((a, b) => b.score - a.score).slice(0, 3).map(({ r }) => r),
    },
  }));
}

const { recipe, pairs } = Astro.props;
const { data } = recipe;
const skills = academyLinksFor(recipe);
const nutrition = await nutritionFor(recipe);
const pin = Astro.site && new URL('https://www.pinterest.com/pin/create/button/');
if (pin && Astro.site) {
  pin.search = new URLSearchParams({
    url: new URL(recipeUrl(recipe.id), Astro.site).href,
    media: new URL(base + (data.image ?? 'images/cookbook-cover.jpg'), Astro.site).href,
    description: `${data.title}. ${data.description}`.slice(0, 500),
  }).toString();
}
const groups = data.ingredients ? ingredients(recipe) : null;
const link = groups ? linkOf(recipe) : null;
const steps = groups ? directions(recipe) : [];
const Content = groups ? null : (await render(recipe)).Content;
const q = (key: string, value: string) => `${base}recipes/?${key}=${encodeURIComponent(value)}`;
---
<Cookbook title={data.title} description={data.description} current="recipes">
  <script type="application/ld+json" set:html={json({
    '@context': 'https://schema.org', '@type': 'Recipe', name: data.title, description: data.description,
    recipeYield: data.servings, totalTime: data.minutes ? `PT${data.minutes}M` : undefined,
    recipeCategory: data.category, recipeCuisine: data.cuisine, recipeIngredient: ingredients(recipe).flatMap(g => g.items),
    recipeInstructions: directions(recipe).map(step => ({ '@type': 'HowToStep', text: step.text })),
    image: data.image && Astro.site ? new URL(base + data.image, Astro.site).href : undefined,
  })} />
  <article class="wrap recipe">
    <a href={base + 'recipes/'} class="index-link">Back to the recipe box</a>
    <div class="sheet">
      <p class="card-tab">{data.category}</p>
      <header class:list={['recipe-heading', { 'no-photo': !data.image }]}>
        <div>
          <h1>{data.title}</h1>
          <p class="description">{data.description}</p>
          {data.author && <p class="credit">From the kitchen of {data.author}</p>}
          <dl class="facts">
            <div><dt>Time</dt><dd>{data.time}</dd></div>
            <div><dt>Serves</dt><dd>{data.servings}</dd></div>
            {data.difficulty && <div><dt>Difficulty</dt><dd>{data.difficulty}</dd></div>}
          </dl>

          <div class="recipe-actions">
            <button type="button" class="button" data-cook hidden>Start cooking</button>
            <button type="button" class="button quiet print-button" hidden>Print recipe</button>
            <button type="button" class="button quiet to-cook-button" data-to-cook={recipe.id} data-title={data.title} hidden>To cook</button>
            <button type="button" class="button quiet" data-add={recipe.id} data-title={data.title} hidden>Add to menu</button>
          </div>
<details class="recipe-more"><summary>Recipe details &amp; sharing</summary>          <ul class="tapes">
            {data.meal.map((m) => <li><a class="tape blue" href={q('meal', m)}>{m}</a></li>)}
            {data.cuisine.map((c) => <li><a class="tape" href={q('cuisine', c)}>{c}</a></li>)}
            {data.tags.map((t) => <li><a class="tape green" href={q('tag', t)}>{t}</a></li>)}
          </ul>            {pin && <a class="button quiet" href={pin.href} target="_blank" rel="noopener noreferrer">Save on Pinterest</a>}</details>
          {isSample(recipe) && <p class="sample">Sample card. It’s here to fill the box until the family recipes are in.</p>}
        </div>
        {data.image ? <figure class="print"><img src={base + data.image} srcset={`${base}card-images/${recipe.id}/360.webp 360w, ${base}card-images/${recipe.id}/720.webp 720w`} sizes="(max-width:720px) 86vw, 440px" alt={data.imageAlt ?? data.title} width="1200" height="800" /></figure> : <Spot category={data.category} />}
      </header>
      <nav class="reader-links" aria-label="Recipe sections"><a href="#ingredients">Ingredients</a><a href="#directions">Directions</a><a href="#notes">Notes</a><a href="#photos">Gallery</a>{nutrition && <a href="#nutrition">Nutrition</a>}<button class="linkish" type="button" id="convert-open" hidden>Convert units</button></nav>
      {skills.length > 0 && <details id="skills" class="technique-help"><summary>Technique help</summary>
        <ul>{skills.map(skill => <li><a href={base + 'academy/#' + skill.id}>{skill.title}</a></li>)}</ul>
      </details>}
      <div class="recipe-body">
        {Content && <Content />}
        {groups && <>
          <section class="sec sec-ingredients" id="ingredients" role="group" aria-describedby="ing-help"><h2>Ingredients</h2><p class="ingredient-progress" id="ingredient-progress" role="status" hidden></p>
            {groups.map((g, gi) => <>{g.name && <h3>{g.name}</h3>}<ul>{g.items.map((item, ii) => <li class="ing-line" data-e={link!.ids[gi][ii]}><input type="checkbox" class="ingredient-tick" aria-label={`Gathered: ${item}`} hidden />{item}</li>)}</ul></>)}
          </section>
          <section class="sec sec-directions" id="directions" role="group" aria-describedby="ing-help"><h2>Directions</h2>
            <p class="ing-hint" id="ing-help">Tap or hover over a marked ingredient to see its amount. Use the arrow keys to move between ingredients.</p>
            <ol role="list">{steps.map((step, si) => (
              <li>
                <p class="step-text">{step.title && <strong class="step-title">{step.title}</strong>}{' '}<Parts parts={link!.steps[si].parts} entries={link!.data.entries} emphasizeTiming /></p>
                {step.why && <details class="why">
                  <summary><span class="why-mark" aria-hidden="true">?</span>Why?<span class="vh"> (step {si + 1})</span></summary>
                  <p><Parts parts={link!.steps[si].whyParts} /></p>
                </details>}
              </li>
            ))}</ol>
          </section>
          <script type="application/json" id="ing-data" set:html={json(link!.data)} />
          {Object.entries(data.notes ?? {}).map(([title, text]) => <section class="sec recipe-note"><h2>{title}</h2><p>{text}</p></section>)}
        </>}
        {data.story && groups && <section class="sec recipe-note"><h2>The story</h2><p>{data.story}</p></section>}
      </div>
      {data.source && <p class="credit source">Adapted from <a href={data.source.url}>{data.source.name}</a>.</p>}
    </div>
    <dialog id="recipe-print"><form method="dialog"><h2>Print recipe</h2><p>Choose what to include on your recipe sheet.</p>
      {data.image && <label><input type="checkbox" id="print-photo" /> Recipe photo</label>}
      {!!data.familyNotes?.length && <label><input type="checkbox" id="print-notes" /> Family notes</label>}
      <div class="block-actions"><button value="print" class="button">Print</button><button value="cancel" class="button quiet">Cancel</button></div></form></dialog>

    {nutrition && <section class="block" id="nutrition"><h2>Nutrition</h2><p>{nutrition.basis}</p><dl>{nutrition.rows.map(n => <div><dt>{n.name}</dt><dd>{n.amount} {n.unit}</dd></div>)}</dl><p>Calculated from the listed ingredients by <a href="https://spoonacular.com/food-api">Spoonacular</a>. Brands and preparation can affect actual values.</p></section>}
    <RecipeExtras recipe={recipe} />
    {pairs.length > 0 && <section class="block pairs" aria-labelledby="pairs-title"><h2 id="pairs-title">Goes well with</h2><ul class="cards">{pairs.map((r) => <RecipeCard recipe={r} />)}</ul></section>}
  </article>
  <dialog id="converter" aria-labelledby="converter-title">
    <form method="dialog">
      <h2 id="converter-title">Kitchen converter</h2>
      <p id="convert-source"></p>
      <div class="converter-fields">
        <label>Amount <input id="convert-amount" type="number" step="any" inputmode="decimal" /></label>
        <label>From <select id="convert-from"></select></label>
        <label>To <select id="convert-to"></select></label>
      </div>
      <output aria-live="polite"></output>
      <p>Volume uses US measures. Converting between volume and weight requires an ingredient-specific density.</p>
      <button class="button quiet">Close</button>
    </form>
  </dialog>
  <CookMode recipe={recipe} />
</Cookbook>
<script>
  import '../../scripts/ingredient-hover';
  import '../../scripts/converter';
  const progress = document.querySelector<HTMLElement>('#ingredient-progress');
  const ticks = [...document.querySelectorAll<HTMLInputElement>('.ingredient-tick')];
  if (progress && ticks.length) {
    const updateProgress = () => {
      const checked = ticks.filter(tick => tick.checked).length;
      progress.textContent = checked === ticks.length ? 'Everything’s on the counter!' : `${checked} of ${ticks.length} ingredients gathered`;
    };
    for (const tick of ticks) {
      tick.hidden = false;
      tick.addEventListener('change', updateProgress);
    }
    progress.hidden = false;
    updateProgress();
    window.addEventListener('pageshow', updateProgress);
  }

  const back = document.querySelector<HTMLAnchorElement>('.index-link')!;
  if (document.referrer) {
    const previous = new URL(document.referrer);
    const box = new URL(back.href);
    if (previous.origin === box.origin && previous.pathname === box.pathname) {
      box.search = previous.search;
      back.href = box.href;
    }
  }

  const print = document.querySelector<HTMLButtonElement>('.print-button')!;
  print.hidden = false;
  const options = document.querySelector<HTMLDialogElement>('#recipe-print')!;
  print.addEventListener('click', () => { options.returnValue = ''; options.showModal(); });
  options.addEventListener('close', () => {
    if (options.returnValue !== 'print') return;
    for (const key of ['photo', 'notes']) document.body.classList.toggle('include-' + key, !!document.querySelector<HTMLInputElement>('#print-' + key)?.checked);
    window.print();
  });
</script>
