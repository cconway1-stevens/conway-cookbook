---
import { render } from 'astro:content';
import Converter from '../../components/Converter.astro';
import UnitChoice from '../../components/UnitChoice.astro';
import Cookbook from '../../layouts/Cookbook.astro';
import RecipeCard from '../../components/RecipeCard.astro';
import Spot from '../../components/Spot.astro';
import { academyLinksFor } from '../../lib/academy';
import { nutritionFor } from '../../lib/nutrition';
import RecipeExtras from '../../components/RecipeExtras.astro';
import Parts from '../../components/Parts.astro';
import CookMode from '../../components/CookMode.astro';
import { allRecipes, base, directions, ingredients, isSample, json, linkOf, recipeUrl } from '../../lib/recipes';

export async function getStaticPaths() {
  const recipes = await allRecipes();
  return recipes.map((recipe) => ({
    params: { id: recipe.id },
    props: {
      recipe,
      // Goes well with: a different course, sharing a cuisine or a meal.
      pairs: recipes
        .filter((r) => r.id !== recipe.id && r.data.category !== recipe.data.category)
        .map((r) => ({ r, score: 2 * Number(r.data.cuisine.some((c) => recipe.data.cuisine.includes(c))) + Number(r.data.meal.some((m) => recipe.data.meal.includes(m))) }))
        .filter(({ score }) => score).sort((a, b) => b.score - a.score).slice(0, 3).map(({ r }) => r),
    },
  }));
}

const { recipe, pairs } = Astro.props;
const { data } = recipe;
const skills = academyLinksFor(recipe);
const nutrition = nutritionFor(recipe);
const pin = Astro.site && new URL('https://www.pinterest.com/pin/create/button/');
if (pin && Astro.site) {
  pin.search = new URLSearchParams({
    url: new URL(recipeUrl(recipe.id), Astro.site).href,
    media: new URL(base + (data.image ?? 'images/cookbook-cover.jpg'), Astro.site).href,
    description: `${data.title}. ${data.description}`.slice(0, 500),
  }).toString();
}
const groups = data.ingredients ? ingredients(recipe) : null;
const link = groups ? linkOf(recipe) : null;
const steps = groups ? directions(recipe) : [];
const Content = groups ? null : (await render(recipe)).Content;
const q = (key: string, value: string) => `${base}recipes/?${key}=${encodeURIComponent(value)}`;
---
<Cookbook title={data.title} description={data.description} current="recipes">
  <script type="application/ld+json" set:html={json({
    '@context': 'https://schema.org', '@type': 'Recipe', name: data.title, description: data.description,
    recipeYield: data.servings, totalTime: data.minutes ? `PT${data.minutes}M` : undefined,
    recipeCategory: data.category, recipeCuisine: data.cuisine, recipeIngredient: ingredients(recipe).flatMap(g => g.items),
    recipeInstructions: directions(recipe).map(step => ({ '@type': 'HowToStep', text: step.text })),
    image: data.image && Astro.site ? new URL(base + data.image, Astro.site).href : undefined,
  })} />
  <article class="wrap recipe">
    <a href={base + 'recipes/'} class="index-link">Back to the recipe box</a>
    <div class="sheet">
      <p class="card-tab">{data.category}</p>
      <header class:list={['recipe-heading', { 'no-photo': !data.image }]}>
        <div>
          <h1>{data.title}</h1>
          <p class="description">{data.description}</p>
          {data.author && <p class="credit">From the kitchen of {data.author}</p>}
          <dl class="facts">
            <div><dt>Time</dt><dd>{data.time}</dd></div>
            <div><dt>Serves</dt><dd>{data.servings}</dd></div>
            {data.difficulty && <div><dt>Difficulty</dt><dd>{data.difficulty}</dd></div>}
          </dl>

          <div class="recipe-actions">
            <button type="button" class="button" data-cook hidden>Start cooking</button>
            <a class="button quiet" href="#ingredients">Read recipe</a>
          </div>
          <details class="recipe-more"><summary>Save, print &amp; share</summary>
            <div class="recipe-tools">
              <button type="button" class="button quiet print-button" hidden>Print recipe</button>
              <button type="button" class="button quiet to-cook-button" data-to-cook={recipe.id} data-title={data.title} hidden>To cook</button>
              <button type="button" class="button quiet" data-add={recipe.id} data-title={data.title} hidden>Add to menu</button>
            </div>
            <ul class="tapes">
              {data.meal.map((m) => <li><a class="tape blue" href={q('meal', m)}>{m}</a></li>)}
              {data.cuisine.map((c) => <li><a class="tape" href={q('cuisine', c)}>{c}</a></li>)}
              {data.tags.map((t) => <li><a class="tape green" href={q('tag', t)}>{t}</a></li>)}
            </ul>
            {pin && <a class="button quiet" href={pin.href} target="_blank" rel="noopener noreferrer">Save on Pinterest</a>}
          </details>
          {isSample(recipe) && <p class="sample">Sample card. It’s here to fill the box until the family recipes are in.</p>}
        </div>
        {data.image ? <figure class="print"><img src={base + data.image} srcset={`${base}card-images/${recipe.id}/360.webp 360w, ${base}card-images/${recipe.id}/720.webp 720w`} sizes="(max-width:720px) 86vw, 440px" alt={data.imageAlt ?? data.title} width="1200" height="800" /></figure> : <Spot category={data.category} />}
      </header>
      <nav class="reader-links" role="tablist" aria-label="Recipe card">
        <a id="tab-recipe" href="#recipe" role="tab" aria-controls="recipe" aria-selected="true" data-card-link="recipe">Recipe</a>
        <a id="tab-nutrition" href="#nutrition" role="tab" aria-controls="nutrition" aria-selected="false" data-card-link="nutrition">Nutrition</a>
        <a id="tab-details" href="#details" role="tab" aria-controls="details" aria-selected="false" data-card-link="details">Details</a>
      </nav>
      <div id="recipe" role="tabpanel" aria-labelledby="tab-recipe">
      <div class="recipe-view-tools"><a class="ingredients-shortcut" href="#ingredients">Ingredients</a><a href="#directions">Directions ↓</a><button class="linkish" type="button" id="convert-open" hidden>Convert units</button></div>
      {!groups && <UnitChoice />}
      <div class="recipe-body">
        {Content && <Content />}
        {groups && <>
          <section class="sec sec-ingredients" id="ingredients" role="group" aria-describedby="ing-help"><h2>Ingredients</h2><UnitChoice /><p class="ingredient-progress" id="ingredient-progress" role="status" hidden></p>
            <div class="ingredient-groups">{groups.map((g, gi) => <div>{g.name && <h3>{g.name}</h3>}<ul>{g.items.map((item, ii) => <li class="ing-line" data-e={link!.ids[gi][ii]}><input type="checkbox" class="ingredient-tick" aria-label={`Gathered: ${item}`} hidden />{item}</li>)}</ul></div>)}</div>
          </section>
          <section class="sec sec-directions" id="directions" role="group" aria-describedby="ing-help"><h2>Directions <small class="step-count">{steps.length} {steps.length === 1 ? 'step' : 'steps'}</small></h2>
            <p class="ing-hint" id="ing-help">Tap or hover over a marked ingredient to see its amount. Use the arrow keys to move between ingredients.</p>
            <ol role="list">{steps.map((step, si) => (
              <li>
                <p class="step-text">{step.title && <strong class="step-title">{step.title}</strong>}{' '}<Parts parts={link!.steps[si].parts} entries={link!.data.entries} emphasizeTiming /></p>
                {step.why && <details class="why">
                  <summary><span class="why-mark" aria-hidden="true">?</span>Why?<span class="vh"> (step {si + 1})</span></summary>
                  <p><Parts parts={link!.steps[si].whyParts} /></p>
                </details>}
              </li>
            ))}</ol>
          </section>
          <script type="application/json" id="ing-data" set:html={json(link!.data)} />
        </>}
      </div>
      </div>
    <dialog id="recipe-print"><form method="dialog"><h2>Print recipe</h2><p>Choose what to include on your recipe sheet.</p>
      {data.image && <label><input type="checkbox" id="print-photo" /> Recipe photo</label>}
      {!!data.familyNotes?.length && <label><input type="checkbox" id="print-notes" /> Family notes</label>}
      <div class="block-actions"><button value="print" class="button">Print</button><button value="cancel" class="button quiet">Cancel</button></div></form></dialog>

    <div id="nutrition" role="tabpanel" aria-labelledby="tab-nutrition">
      {nutrition ? <>
        <section class="nutrition-label" aria-labelledby="nutrition-title">
          <h2 id="nutrition-title">Nutrition Facts</h2>
          <p class="nutrition-basis"><strong>Serving size</strong> {nutrition.serving}</p>
          <p class="nutrition-estimate">Estimated amount per {nutrition.serving === 'Whole recipe' ? 'recipe' : 'serving'}</p>
          <p class="nutrition-calories"><strong>Calories</strong> <strong>{nutrition.rows[0].value}</strong></p>
          <table class="nutrition-table" aria-label="Estimated nutrients">
            <thead><tr><th scope="col" class="vh">Nutrient</th><th scope="col" class="vh">Amount</th><th scope="col">% Daily Value</th></tr></thead>
            <tbody>{nutrition.rows.slice(1).map(({ name, value, daily, indent }) => (
              <tr class:list={{ 'nested-nutrient': indent, 'nutrient-divider': name === 'Vitamin D' }}>
                <th scope="row">{name}</th><td>{value === '—' ? <><span aria-hidden="true">—</span><span class="vh">Not available</span></> : value}</td><td>{daily}</td>
              </tr>
            ))}</tbody>
          </table>
          <p class="nutrition-note">Daily Values use the FDA reference amounts for a 2,000-calorie diet. A dash means the estimate is unavailable.</p>
        </section>
        <section class="nutrition-guide"><h3>About this estimate</h3>
          <p>Estimated from the listed ingredients and recipe yield. Brands, preparation, and portion size affect the actual values.</p>
          {nutrition.assumptions && <p>{nutrition.assumptions}</p>}
          <p>Data: {nutrition.sources ? nutrition.sources.map(({ name, url }, i) => <>{i > 0 && ' · '}<a href={url}>{name}</a></>) : <a href="https://spoonacular.com/food-api">Spoonacular</a>}.</p>
        </section>
      </> : <section class="nutrition-guide"><h2>Nutrition Facts</h2><p>An estimate for the current ingredients and yield is unavailable.</p></section>}
    </div>
    <div id="details" role="tabpanel" aria-labelledby="tab-details">
      {skills.length > 0 && <details id="skills" class="technique-help"><summary>Technique help</summary>
        <p>Step-by-step guides from OvenSource’s ChefStudio.</p>
        <ul>{skills.map(skill => <li><a href={skill.href}>{skill.title}</a></li>)}</ul>
      </details>}
      {data.source && <p class="credit source">Adapted from <a href={data.source.url}>{data.source.name}</a>.</p>}

    <RecipeExtras recipe={recipe}>
      {groups && Object.entries(data.notes ?? {}).map(([title, text]) => <section class="sec recipe-note"><h3>{title}</h3><p>{text}</p></section>)}
      {data.story && groups && <section class="recipe-note"><h3>The story</h3><p>{data.story}</p></section>}
    </RecipeExtras>
    {pairs.length > 0 && <section class="block pairs" aria-labelledby="pairs-title"><h2 id="pairs-title">Goes well with</h2><ul class="cards">{pairs.map((r) => <RecipeCard recipe={r} />)}</ul></section>}
    </div>
    </div>
  </article>
  <Converter />
  <CookMode recipe={recipe} />
</Cookbook>
<script>
  import '../../scripts/ingredient-hover';
  const card = document.querySelector<HTMLElement>('.wrap.recipe')!;
  const viewLinks = card.querySelectorAll<HTMLAnchorElement>('[data-card-link]');
  function showSection() {
    const target = document.getElementById(location.hash.slice(1));
    const view = target?.closest('[role="tabpanel"]')?.id ?? 'recipe';
    card.dataset.view = view;
    for (const link of viewLinks) {
      const active = link.dataset.cardLink === view;
      link.setAttribute('aria-selected', String(active));
      link.tabIndex = active ? 0 : -1;
    }
    if (target && card.contains(target)) target.scrollIntoView({block: 'start'});
  }
  for (const [index, link] of viewLinks.entries()) {
    link.addEventListener('keydown', event => {
      const next = event.key === 'Home' ? 0 : event.key === 'End' ? viewLinks.length - 1 :
        event.key === 'ArrowRight' ? (index + 1) % viewLinks.length :
        event.key === 'ArrowLeft' ? (index + viewLinks.length - 1) % viewLinks.length : -1;
      if (next < 0) return;
      event.preventDefault();
      viewLinks[next].focus();
      viewLinks[next].click();
    });
  }
  showSection();
  window.addEventListener('hashchange', showSection);
  const progress = document.querySelector<HTMLElement>('#ingredient-progress');
  const ticks = [...document.querySelectorAll<HTMLInputElement>('.ingredient-tick')];
  if (progress && ticks.length) {
    const storageKey = 'cookbook:gathered:' + location.pathname;
    // Match the full list so an edited recipe never restores obsolete checkmarks.
    const signature = JSON.stringify(ticks.map(tick => tick.getAttribute('aria-label')));
    try {
      const saved = JSON.parse(sessionStorage.getItem(storageKey) ?? 'null');
      if (saved?.signature === signature && Array.isArray(saved.checked)) {
        ticks.forEach((tick, index) => { tick.checked = saved.checked[index] === true; });
      }
    } catch { /* The checklist also works when storage is unavailable. */ }
    const updateProgress = () => {
      const checked = ticks.filter(tick => tick.checked).length;
      progress.textContent = checked === ticks.length ? 'Everything’s on the counter!' : `${checked} of ${ticks.length} ingredients gathered`;
    };
    for (const tick of ticks) {
      tick.hidden = false;
      tick.addEventListener('change', () => {
        updateProgress();
        try {
          sessionStorage.setItem(storageKey, JSON.stringify({ signature, checked: ticks.map(input => input.checked) }));
        } catch { /* Keep using the checklist in memory. */ }
      });
    }
    progress.hidden = false;
    updateProgress();
    window.addEventListener('pageshow', updateProgress);
  }

  const back = document.querySelector<HTMLAnchorElement>('.index-link')!;
  if (document.referrer) {
    const previous = new URL(document.referrer);
    const box = new URL(back.href);
    if (previous.origin === box.origin && previous.pathname === box.pathname) {
      box.search = previous.search;
      back.href = box.href;
    }
  }

  const print = document.querySelector<HTMLButtonElement>('.print-button')!;
  print.hidden = false;
  const options = document.querySelector<HTMLDialogElement>('#recipe-print')!;
  print.addEventListener('click', () => { options.returnValue = ''; options.showModal(); });
  options.addEventListener('close', () => {
    if (options.returnValue !== 'print') return;
    for (const key of ['photo', 'notes']) document.body.classList.toggle('include-' + key, !!document.querySelector<HTMLInputElement>('#print-' + key)?.checked);
    window.print();
  });
</script>

<style>
  @media screen {
    .facts {
      border-block: 1px solid var(--line);
      padding-block: .85rem;
    }
    .facts dd { font-size: 1.18rem; }
    .recipe-actions { align-items: stretch; }
    .recipe-actions [data-cook] { flex: 0 1 auto; padding: .65rem 1.2rem; font-size: 1.1rem; }
    .recipe-tools { display: flex; flex-wrap: wrap; gap: .5rem; margin-block: .75rem; }
    .reader-links { gap: .3rem .65rem; }
    .reader-links a { display: inline-flex; align-items: center; min-height: 2.75rem; }
    .sec-ingredients { border-top: .25rem solid var(--accent); }
    .step-count { font: 400 1rem var(--body); color: var(--soft); white-space: nowrap; }
    .step-title { display: block; margin-bottom: .25rem; }
    .sec-directions li { padding-inline-start: 3rem; }
    .sec-directions li::before {
      display: grid;
      place-items: center;
      width: 2.2rem;
      height: 2.2rem;
      background: var(--tint);
      border: 1px solid var(--line);
      border-radius: 50%;
      font-size: 1.25rem;
    }
  }
  @media print { .step-count, .recipe-tools { display: none; } }
</style>
