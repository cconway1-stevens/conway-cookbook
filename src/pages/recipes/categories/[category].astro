---
import type { InferGetStaticPropsType } from 'astro';
// Keeps every published /recipes/categories/ link working, for courses and meals alike.
import Cookbook from '../../../layouts/Cookbook.astro';
import RecipeSections from '../../../components/RecipeSections.astro';
import { allRecipes, base } from '../../../lib/recipes';
import { book, courseAliases, courseNames, slug } from '../../../lib/cookbook';

export async function getStaticPaths() {
  const recipes = await allRecipes();
  const pages = [...new Set([...book.meals, ...courseNames])]
    .map((name) => ({ name, list: recipes.filter((r) => r.data.category === name || r.data.meal.includes(name)) }))
    .filter(({ list }) => list.length)
    .map(({ name, list }) => ({ params: { category: slug(name) }, props: { name, list } }));
  const aliases = Object.entries(courseAliases).flatMap(([category, name]) => {
    const target = pages.find(page => page.props.name === name);
    return target ? [{ params: { category }, props: target.props }] : [];
  });
  return [...pages, ...aliases];
}
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { name, list } = Astro.props;
---
<Cookbook title={name} current="recipes">
  <section class="wrap box">
    <div class="block-head"><h1>{name}</h1><a class="button quiet" href={base + 'recipes/'}>Search the whole box</a></div>
    <RecipeSections name={name} recipes={list} level="h2" />
  </section>
</Cookbook>
