---
// Keeps every published /recipes/categories/ link working, for courses and meals alike.
import Cookbook from '../../../layouts/Cookbook.astro';
import RecipeCard from '../../../components/RecipeCard.astro';
import { allRecipes, base } from '../../../lib/recipes';
import { book, courseNames, slug } from '../../../lib/cookbook';

export async function getStaticPaths() {
  const recipes = await allRecipes();
  return [...new Set([...book.meals, ...courseNames])]
    .map((name) => ({ name, list: recipes.filter((r) => r.data.category === name || r.data.meal.includes(name)) }))
    .filter(({ list }) => list.length)
    .map(({ name, list }) => ({ params: { category: slug(name) }, props: { name, list } }));
}
const { name, list } = Astro.props;
---
<Cookbook title={name} current="recipes">
  <section class="wrap box">
    <div class="block-head"><h1>{name}</h1><a class="button quiet" href={base + 'recipes/'}>Search the whole box</a></div>
    <ul class="cards">{list.map((recipe) => <RecipeCard recipe={recipe} level="h2" />)}</ul>
  </section>
</Cookbook>
