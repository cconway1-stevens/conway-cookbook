---
import Cookbook from '../../layouts/Cookbook.astro';
import RecipeSections from '../../components/RecipeSections.astro';
import { allRecipes, tally } from '../../lib/recipes';
import { book, courseAliases, slug } from '../../lib/cookbook';
const recipes = await allRecipes();
const meals = book.meals.filter((m) => recipes.some((r) => r.data.meal.includes(m)));
const cuisines = tally(recipes.flatMap((r) => r.data.cuisine));
// Most-used tags first, so the short list shows the useful ones.
const tags = tally(recipes.flatMap((r) => r.data.tags)).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const shortTags = 10;
const times = [['', 'Any time'], ['20', '20 min'], ['30', '30 min'], ['60', '1 hour'], ['90', '1½ hours']];
const drawers = book.courses.map(({ name }) => ({ name, id: slug(name), recipes: recipes.filter(recipe => recipe.data.category === name) })).filter(drawer => drawer.recipes.length);
const drawerGroups = [
  { label: 'Breakfast', drawers: drawers.filter(({ id }) => id === 'breakfast') },
  { label: 'Savory recipes', drawers: drawers.filter(({ id }) => !['breakfast', 'desserts', 'drinks'].includes(id)) },
  { label: 'Desserts and drinks', drawers: drawers.filter(({ id }) => ['desserts', 'drinks'].includes(id)) },
].filter(group => group.drawers.length);
const drawerAliases = Object.fromEntries(Object.entries(courseAliases).map(([alias, name]) => [`drawer-${alias}`, `drawer-${slug(name)}`]));
import '../../catalog.css';
---
<Cookbook title="Recipe box" description="Search every recipe by meal, cuisine, time, or ingredient." current="recipes" showHeaderSearch={false}>
  <div class="wrap box" data-drawer-aliases={JSON.stringify(drawerAliases)}>
    <div class="block-head box-heading">
      <h1>The recipe box</h1>
      <div class="box-actions">
        <button type="button" class="button quiet box-queue" id="queue" aria-pressed="false" hidden>To cook</button>
        <button type="button" class="button quiet" id="catalog-pick" hidden>Deal a card</button>
      </div>
    </div>
    <div class="catalog-bar" id="catalog-bar">
    <form id="filters" class="filters" role="search" aria-label="Find recipes" hidden>
      <div class="catalog-toolbar">
      <div class="search">
        <label class="vh" for="q">Search by dish, ingredient, or tag</label>
        <input id="q" name="q" type="search" placeholder="Find a dish or ingredient" autocomplete="off" enterkeyhint="search" />
      </div>
      <details class="more-filters"><summary><svg class="fsliders" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M3 5h8M15 5h2M3 10h2M9 10h8M3 15h10" /><circle cx="13" cy="5" r="2" /><circle cx="7" cy="10" r="2" /><circle cx="15" cy="15" r="2" /></svg>Filters <span id="filter-count" hidden></span></summary><div class="filter-options">
        {/* Every choice is a chip. The small number is how many recipes you'd see if you picked it. */}
        <fieldset class="frow"><legend>Meal</legend><div class="fchips">
          {['', ...meals].map((m) => <label class="fchip"><input type="radio" name="meal" value={m} checked={m === ''} /><span>{m || 'Any'}{m && <small data-n></small>}</span></label>)}
        </div></fieldset>
        <fieldset class="frow"><legend>Ready in</legend><div class="fchips">
          {times.map(([v, text]) => <label class="fchip"><input type="radio" name="ready" value={v} checked={v === ''} /><span>{v ? `≤ ${text}` : text}{v && <small data-n></small>}</span></label>)}
        </div></fieldset>
        <fieldset class="frow"><legend>Cuisine</legend><div class="fchips">
          {cuisines.map(([c]) => <label class="fchip"><input type="checkbox" name="cuisine" value={c} /><span>{c}<small data-n></small></span></label>)}
        </div></fieldset>
        <fieldset class="frow"><legend>Tags</legend><div class="fchips" id="tag-chips" data-short>
          {tags.map(([t], i) => <label class:list={['fchip', { extra: i >= shortTags }]}><input type="checkbox" name="tag" value={t} /><span>{t}<small data-n></small></span></label>)}
          {tags.length > shortTags && <button type="button" class="fchip-more" id="more-tags" aria-controls="tag-chips" aria-expanded="false">+ {tags.length - shortTags} more</button>}
        </div></fieldset>
        <div class="ffoot">
          <button type="button" class="linkish" id="clear-filters">Clear filters</button>
          <button type="button" class="button" id="show-results">Show recipes</button>
        </div>
      </div></details>
      </div>
    </form>
    <nav class="drawer-index" aria-label="Jump to a category">
      {drawerGroups.map(group => (
        <div class="drawer-group" role="group" aria-label={group.label}>
          {group.drawers.map(drawer => <a data-drawer-link={drawer.id} href={'#drawer-' + drawer.id}>{drawer.name} <small>{drawer.recipes.length}</small></a>)}
        </div>
      ))}
    </nav>
    </div>
    <div class="results catalog-results">
      <p id="count" role="status">{recipes.length} recipes</p>
      <div class="catalog-options" hidden>
        <label>Sort <select id="catalog-sort"><option value="">By category</option><option value="quick">Quickest first</option><option value="az">Name A–Z</option></select></label>
        <button type="button" class="linkish" id="catalog-layout" aria-pressed="false">Compact view</button>
      </div>
      <button type="button" id="clear" class="linkish" hidden>Clear all</button>
    </div>
    <ul id="active-filters" class="active-filters" aria-label="Applied filters" role="list" hidden></ul>
    <p id="cookie-jar" class="cookie-note" role="status" hidden>The cookie jar is open. There’s chocolate in that drawer.</p>
    <ul class="cards" id="catalog-sorted" hidden></ul>
    {drawers.map((drawer, i) => <section class="catalog-drawer" id={'drawer-' + drawer.id} data-drawer={drawer.id} aria-labelledby={'label-' + drawer.id} style={`--pos: ${[0, .5, 1][i % 3]}`}>
      <h2 id={'label-' + drawer.id}><span>{drawer.name}</span></h2>
      <RecipeSections name={drawer.name} recipes={drawer.recipes} level="h3" />
    </section>)}
    <dialog id="catalog-deal" aria-labelledby="deal-title"><form method="dialog">
      <h2 id="deal-title">Your card</h2>
      <p id="deal-recipe"></p>
      <div class="block-actions"><a class="button" id="deal-link">Open recipe</a><button type="button" class="button quiet" id="deal-again">Deal again</button><button class="linkish">Close</button></div>
    </form></dialog>
    <div id="none" class="none" hidden>
      <h2>No card for that yet</h2>
      <p id="none-help">Remove a filter or try a different ingredient or dish.</p>
      <button type="button" class="button" id="clear2">Show every recipe</button>
    </div>
  </div>
</Cookbook>
<script>
  import { toCook } from '../../scripts/to-cook';
  import { replay } from '../../scripts/motion';
  const form = document.querySelector<HTMLFormElement>('#filters')!;
  const cards = [...document.querySelectorAll<HTMLElement>('.card')];
  const count = document.querySelector('#count')!, clear = document.querySelector<HTMLElement>('#clear')!, none = document.querySelector<HTMLElement>('#none')!;
  const queue = document.querySelector<HTMLButtonElement>('#queue')!;
  const box = document.querySelector<HTMLElement>('.box')!;
  const drawerAliases: Record<string, string> = JSON.parse(box.dataset.drawerAliases!);
  const drawers = [...box.querySelectorAll<HTMLElement>('[data-drawer]')];
  const sorted = document.querySelector<HTMLUListElement>('#catalog-sorted')!;
  const sort = document.querySelector<HTMLSelectElement>('#catalog-sort')!;
  const layout = document.querySelector<HTMLButtonElement>('#catalog-layout')!;
  const deal = document.querySelector<HTMLDialogElement>('#catalog-deal')!;
  const pick = document.querySelector<HTMLButtonElement>('#catalog-pick')!;
  const cookie = document.querySelector<HTMLElement>('#cookie-jar')!;
  let lastDeal: HTMLElement | undefined;
  const noneHelp = document.querySelector('#none-help')!;
  let queuedOnly = false;
  const search = form.querySelector<HTMLInputElement>('#q')!;
  const activeFilters = document.querySelector<HTMLUListElement>('#active-filters')!;
  const filterCount = document.querySelector<HTMLElement>('#filter-count')!;
  const showResults = document.querySelector<HTMLButtonElement>('#show-results')!;
  // A chip's words, without its count.
  const chipText = (input: HTMLInputElement | null) => input?.nextElementSibling?.firstChild?.textContent?.trim() ?? '';
  const fold = (text: string) => text.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
  const index = cards.map((card) => ({
    card, shelf: card.parentElement!, title: card.querySelector<HTMLAnchorElement>('.card-title a')!, text: fold(card.dataset.search!), minutes: Number(card.dataset.minutes) || Infinity,
    meal: card.dataset.meal!.split('|'), cuisine: card.dataset.cuisine!.split('|'), tags: card.dataset.tags!.split('|'),
  }));

  const read = () => {
    const data = new FormData(form);
    return {
      q: String(data.get('q') ?? '').trim(), meal: String(data.get('meal') ?? ''), ready: String(data.get('ready') ?? ''),
      cuisine: data.getAll('cuisine').map(String), tag: data.getAll('tag').map(String),
    };
  };
  type State = ReturnType<typeof read>;
  function showApplied(s: State) {
    const selected = [
      ...(s.q ? [{ name: 'q', value: s.q, label: `Search: ${s.q}` }] : []),
      ...(s.meal ? [{ name: 'meal', value: s.meal, label: s.meal }] : []),
      ...s.cuisine.map((value) => ({ name: 'cuisine', value, label: value })),
      ...s.tag.map((value) => ({ name: 'tag', value, label: value })),
      ...(s.ready ? [{ name: 'ready', value: s.ready, label: `Ready in ${chipText(form.querySelector<HTMLInputElement>('[name=ready]:checked'))}` }] : []),
    ];
    activeFilters.replaceChildren(...selected.map(({ name, value, label }) => {
      const li = document.createElement('li');
      const button = document.createElement('button');
      button.type = 'button';
      button.dataset.name = name;
      button.dataset.value = value;
      button.setAttribute('aria-label', `Remove ${label} filter`);
      const cross = document.createElement('span');
      cross.setAttribute('aria-hidden', 'true');
      cross.textContent = '×';
      button.append(label, cross);
      li.append(button);
      return li;
    }));
    activeFilters.hidden = clear.hidden = !selected.length;
    const advanced = Number(Boolean(s.meal)) + s.cuisine.length + s.tag.length + Number(Boolean(s.ready));
    filterCount.textContent = String(advanced);
    filterCount.hidden = !advanced;
  }
  const matches = (row: (typeof index)[number], s: State) =>
    fold(fold(s.q) === 'cookie jar' ? 'cookie' : s.q).split(/\s+/).every((word) => row.text.includes(word)) &&
    (!s.meal || row.meal.includes(s.meal)) &&
    (!s.cuisine.length || s.cuisine.some((c) => row.cuisine.includes(c))) &&
    s.tag.every((t) => row.tags.includes(t)) &&
    (!s.ready || row.minutes <= Number(s.ready));

  function apply(writeUrl = true) {
    const s = read();
    const shown = index.filter((row) => {
      const was = row.card.hidden;
      row.card.hidden = !matches(row, s) || (queuedOnly && !toCook(row.card.dataset.id!));
      if (was && !row.card.hidden) replay(row.card, 'back');
      return !row.card.hidden;
    }).length;
    cookie.hidden = fold(s.q) !== 'cookie jar' || !shown;
    pick.disabled = !shown;
    sorted.hidden = !sort.value;
    for (const drawer of drawers) {
      const rows = index.filter(row => drawer.contains(row.shelf));
      const total = rows.filter(row => !row.card.hidden).length;
      for (const section of drawer.querySelectorAll<HTMLElement>('[data-recipe-section]')) {
        section.hidden = !rows.some(row => section.contains(row.shelf) && !row.card.hidden);
      }
      const link = box.querySelector<HTMLAnchorElement>(`[data-drawer-link="${drawer.dataset.drawer}"]`)!;
      link.querySelector('small')!.textContent = String(total);
      drawer.hidden = link.hidden = !!sort.value || !total;
    }
    const words = `${shown} ${shown === 1 ? 'recipe' : 'recipes'}`;
    if (count.textContent !== words) { count.textContent = words; replay(count, 'bump'); }
    none.hidden = shown > 0;
    const queued = index.filter(row => toCook(row.card.dataset.id!)).length;
    queue.textContent = `To cook (${queued})`;
    queue.setAttribute('aria-pressed', String(queuedOnly));
    noneHelp.textContent = queuedOnly && !queued
      ? 'Use + To cook on any recipe to start your list.'
      : 'Remove a filter or try a different ingredient or dish.';
    showApplied(s);
    document.querySelectorAll<HTMLButtonElement>('[data-pull]').forEach((b) => (b.disabled = !shown));
    // Each chip counts the recipes you'd see if you picked it, and greys out at zero.
    for (const input of form.querySelectorAll<HTMLInputElement>('.fchip input')) {
      const next = input.name === 'cuisine' ? { ...s, cuisine: [input.value] }
        : input.name === 'tag' ? { ...s, tag: [...new Set([...s.tag, input.value])] }
        : { ...s, [input.name as 'meal' | 'ready']: input.value };
      const n = index.filter((row) => matches(row, next) && (!queuedOnly || toCook(row.card.dataset.id!))).length;
      const out = input.nextElementSibling?.querySelector('[data-n]');
      if (out) out.textContent = String(n);
      input.disabled = !input.checked && !n;
    }
    showResults.textContent = shown ? `Show ${words}` : 'No recipes match';
    if (!writeUrl) return;
    const params = new URLSearchParams();
    if (sort.value) params.set('sort', sort.value);
    if (box.dataset.layout === 'compact') params.set('layout', 'compact');
    if (queuedOnly) params.set('view', 'to-cook');
    if (s.q) params.set('q', s.q);
    if (s.meal) params.set('meal', s.meal);
    s.cuisine.forEach((c) => params.append('cuisine', c));
    s.tag.forEach((t) => params.append('tag', t));
    if (s.ready) params.set('ready', s.ready);
    history.replaceState(null, '', location.pathname + (params.size ? `?${params}` : '') + location.hash);
    markCurrent();
  }

  // Keep the search and category row pinned, and tell the drawers how tall it is
  // so a jump lands below it rather than underneath it.
  const bar = document.querySelector<HTMLElement>('#catalog-bar')!;
  const nav = bar.querySelector<HTMLElement>('.drawer-index')!;
  const barHeight = () => bar.getBoundingClientRect().height;
  const sizeBar = () => box.style.setProperty('--catalog-bar', `${Math.round(barHeight())}px`);
  new ResizeObserver(sizeBar).observe(bar);

  // Light up the category you are reading, and slide it into view on phones.
  let current: HTMLAnchorElement | null = null;
  function markCurrent() {
    bar.classList.toggle('stuck', scrollY > 0 && bar.getBoundingClientRect().top <= 0);
    const line = barHeight() + 64;
    const open = drawers.filter((drawer) => !drawer.hidden);
    // Measure from the folder's tab, which rises above the folder itself.
    const here = open.findLast((drawer) => (drawer.querySelector('h2') ?? drawer).getBoundingClientRect().top <= line) ?? null;
    const link = here && box.querySelector<HTMLAnchorElement>(`[data-drawer-link="${here.dataset.drawer}"]`);
    if (link === current) return;
    current?.removeAttribute('aria-current');
    current = link;
    if (!link) { nav.scrollTo({ left: 0, behavior: 'smooth' }); return; }
    link.setAttribute('aria-current', 'location');
    if (nav.scrollWidth > nav.clientWidth) {
      const left = nav.scrollLeft + link.getBoundingClientRect().left - nav.getBoundingClientRect().left;
      nav.scrollTo({ left: left - (nav.clientWidth - link.offsetWidth) / 2, behavior: 'smooth' });
    }
  }
  let ticking = false;
  window.addEventListener('scroll', () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => { ticking = false; markCurrent(); });
  }, { passive: true });

  // A link like /recipes/#drawer-mains: the search bar appears and fonts settle
  // after the browser has already jumped, so jump again once the layout is final.
  // Skipped on Back and reload, where the browser restores your own place.
  const arrival = (performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined)?.type;
  let touched = false;
  for (const type of ['wheel', 'touchstart', 'keydown', 'pointerdown']) {
    window.addEventListener(type, () => { touched = true; }, { once: true, passive: true });
  }
  const land = () => {
    if (touched || arrival === 'back_forward' || arrival === 'reload' || !location.hash.startsWith('#drawer-')) return;
    const hash = location.hash.slice(1);
    const drawer = document.getElementById(drawerAliases[hash] ?? hash);
    if (!drawer || drawer.hidden) return;
    sizeBar();
    drawer.scrollIntoView({ block: 'start' });
    markCurrent();
  };
  function fromUrl() {
    const params = new URLSearchParams(location.search);
    form.reset();
    queuedOnly = params.get('view') === 'to-cook';
    search.value = params.get('q') ?? '';
    form.querySelectorAll<HTMLInputElement>('input[type=radio], input[type=checkbox]').forEach((input) => {
      if (params.has(input.name)) input.checked = params.getAll(input.name).includes(input.value);
    });
    for (const name of ['meal', 'ready']) {
      if (!form.querySelector(`[name=${name}]:checked`)) form.querySelector<HTMLInputElement>(`[name=${name}]`)!.checked = true;
    }
    sort.value = params.get('sort') === 'quick' ? 'quick' : params.get('sort') === 'az' ? 'az' : '';
    box.dataset.layout = params.get('layout') === 'compact' ? 'compact' : '';
    layout.setAttribute('aria-pressed', String(box.dataset.layout === 'compact'));
    arrange();
    apply(false);
  }

  function arrange() {
    if (!sort.value) {
      for (const { card, shelf } of index) shelf.append(card);
      return;
    }
    const alphabetical = (a: typeof index[number], b: typeof index[number]) => a.title.textContent!.localeCompare(b.title.textContent!);
    const ordered = [...index].sort((a, b) => sort.value === 'quick' ? (a.minutes - b.minutes || alphabetical(a, b)) : alphabetical(a, b));
    sorted.append(...ordered.map(row => row.card));
  }

  function dealCard() {
    const visible = index.filter(row => !row.card.hidden);
    if (!visible.length) return;
    const pool = visible.length > 1 ? visible.filter(row => row.card !== lastDeal) : visible;
    const row = pool[Math.floor(Math.random() * pool.length)];
    lastDeal = row.card;
    document.querySelector('#deal-recipe')!.textContent = row.title.textContent;
    document.querySelector<HTMLAnchorElement>('#deal-link')!.href = row.title.href;
    if (!deal.open) deal.showModal();
    replay(deal, 'card-dealt');
  }

  pick.hidden = false;
  pick.addEventListener('click', dealCard);
  document.querySelector('#deal-again')!.addEventListener('click', dealCard);
  document.addEventListener('keydown', event => {
    if (event.key !== '/' || event.ctrlKey || event.metaKey || event.altKey || deal.open ||
        document.querySelector('dialog[open]') || (event.target instanceof Element && event.target.closest('input, textarea, select, [contenteditable]'))) return;
    event.preventDefault();
    search.focus();
  });
  box.querySelector<HTMLElement>('.catalog-options')!.hidden = false;
  sort.addEventListener('change', () => { arrange(); apply(); });
  layout.addEventListener('click', () => {
    const compact = box.dataset.layout !== 'compact';
    box.dataset.layout = compact ? 'compact' : '';
    layout.setAttribute('aria-pressed', String(compact));
    apply();
  });
  const reset = () => { form.reset(); apply(); search.focus(); };
  form.hidden = false;
  queue.hidden = false;
  queue.addEventListener('click', () => { queuedOnly = !queuedOnly; apply(); });
  document.addEventListener('to-cook:change', () => apply(false));
  activeFilters.addEventListener('click', (event) => {
    const button = (event.target as Element).closest('button');
    if (!button) return;
    const position = [...activeFilters.querySelectorAll('button')].indexOf(button);
    const { name, value } = button.dataset;
    if (name === 'q') search.value = '';
    else if (name === 'ready' || name === 'meal') form.querySelector<HTMLInputElement>(`[name=${name}][value=""]`)!.checked = true;
    else {
      const chosen = [...form.querySelectorAll<HTMLInputElement>('input[type=checkbox]')]
        .find((input) => input.name === name && input.value === value);
      if (chosen) chosen.checked = false;
    }
    apply();
    const remaining = activeFilters.querySelectorAll('button');
    (remaining[Math.min(position, remaining.length - 1)] ?? search).focus();
  });
  form.addEventListener('input', () => apply());
  form.addEventListener('submit', (event) => event.preventDefault());
  clear.addEventListener('click', reset);

  // Filter panel: more tags, clear just the filters, and jump to what they found.
  const tagChips = document.querySelector<HTMLElement>('#tag-chips')!;
  const moreTags = document.querySelector<HTMLButtonElement>('#more-tags');
  const moreLabel = moreTags?.textContent ?? '';
  moreTags?.addEventListener('click', () => {
    const short = tagChips.toggleAttribute('data-short');
    moreTags.setAttribute('aria-expanded', String(!short));
    moreTags.textContent = short ? moreLabel : 'Fewer tags';
  });
  document.querySelector('#clear-filters')!.addEventListener('click', () => {
    const words = search.value;
    form.reset();
    search.value = words;
    apply();
  });
  showResults.addEventListener('click', () => {
    form.querySelector<HTMLDetailsElement>('.more-filters')!.open = false;
    count.scrollIntoView({ block: 'start', behavior: 'smooth' });
  });
  document.querySelector('#clear2')!.addEventListener('click', () => { queuedOnly = false; reset(); });
  window.addEventListener('pageshow', fromUrl);
  fromUrl();
  requestAnimationFrame(land);
  document.fonts?.ready.then(land);
  window.addEventListener('load', land, { once: true });
</script>
